% ---------------------------------------------------- lost-mark list
% \defL{key}{n}{text}: numbered once, here. Handout prints all of them,
% slides the most common; sheets refer to them with \Lref{key}.
% Source: the assessment schedules' own wording ("correct simplified
% fraction", "positive index", "not bashed") plus teaching observation.
% No examiner report was supplied, and none is cited.
\newcommand\Lprefix{L}
\newcommand\defL[3]{\expandafter\def\csname Lnum@#1\endcsname{#2}%
  \expandafter\def\csname Ltxt@#1\endcsname{#3}}
\newcommand\Lref[1]{\ifcsname Lnum@#1\endcsname
  \Lprefix\csname Lnum@#1\endcsname\else\errmessage{undefined L key #1}\fi}
\newcommand\Ltext[1]{\csname Ltxt@#1\endcsname}

\defL{negindex}{1}{Negative index left in the answer, or put on the wrong factor}
