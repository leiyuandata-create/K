% shared.sty -- NCEA L2 Algebra (91261) unit: colours, terms, lost-mark
% list, Sam's handwriting, shared figures. Loaded by every slide deck and
% every printed sheet, so a term, an L-number or a figure exists once.
% Must not load fontspec (slidestyle/docstyle load it through mathspec).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{shared}[2026/10/05 L2 Algebra shared macros]

\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,patterns}

% ------------------------------------------------------------ colours
\definecolor{ansred}{RGB}{200,16,46}
\definecolor{accent}{RGB}{0,84,110}
\definecolor{rule}{gray}{0.45}
\definecolor{boxfill}{gray}{0.95}      % boxes: at most about 10 % grey
\definecolor{sig}{gray}{0.55}
\definecolor{pagenum}{gray}{0.30}      % n / N: darker than the signature
\definecolor{pencil}{gray}{0.35}       % Sam's drawings

% -------------------------------------------------------------- terms
