% docstyle.sty -- printed A4 sheets (classwork, mini mock, homework).
% One source, two outputs: \def\withanswers{1} before \documentclass
% gives the answer version in red on the identical layout (spec 6.1).
% Headings are bold text over a thin rule and boxes are outlines with a
% light fill: nothing prints as a solid dark area (spec 3.3).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{docstyle}[2026/10/04 Plants and metals printed sheets]

\RequirePackage{type1cm}
\RequirePackage{fix-cm}
\RequirePackage[a4paper,top=15mm,bottom=19mm,left=17mm,right=17mm,footskip=9mm]{geometry}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathspec}
\setmainfont[Path=fonts/, Extension=.otf, UprightFont=*-regular,
  BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic]{texgyrepagella}
\setsansfont[Path=fonts/, Extension=.otf, UprightFont=*-regular,
  BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic]{texgyreheros}
\setmathsfont(Digits,Latin)[Path=fonts/, Extension=.otf,
  UprightFont=*-regular, ItalicFont=*-italic]{texgyrepagella}
\setmathrm[Path=fonts/, Extension=.otf, UprightFont=*-regular,
  BoldFont=*-bold, ItalicFont=*-italic]{texgyrepagella}

\newcommand\sSam{\fontsize{13}{16}\selectfont}
\RequirePackage{shared}
\RequirePackage{array,tabularx,booktabs,enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}

\setlength\parindent{0pt}
\setlength\parskip{3pt plus 1pt}
\setlength\emergencystretch{2em}
\renewcommand\arraystretch{1.3}
\setlist{nosep, leftmargin=*, topsep=2pt, itemsep=1pt}
\renewcommand\figfont{\small}

% ------------------------------------------------ answer switch
\newif\ifansmode
\ifdefined\withanswers \ansmodetrue \fi

% ------------------------------------------------ headings: text + rule
\titleformat{\section}{\needspace{6\baselineskip}\sffamily\bfseries\large}{}{0pt}{}[\vspace{-2pt}{\color{rule}\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{9pt}{4pt}

% ------------------------------------------------ footer: signature
\pagestyle{fancy}
\fancyhf{}
\renewcommand\headrulewidth{0pt}
\newcommand\sheetname{}
\fancyfoot[L]{\footnotesize\sffamily\color{sig}\sheetname}
\fancyfoot[C]{\footnotesize\sffamily\color{sig}\thepage}
\fancyfoot[R]{\footnotesize\sffamily\color{sig}Dr. Ryan Lei \textperiodcentered{} Auckland}
\fancypagestyle{plain}{}

% ------------------------------------------------ answer-only material
% \ansnote{h}{text}: reserves height h in both versions; prints only in
% the answer version; an outgrown note reports Overfull \vbox.
\newcommand\ansnote[2]{\par\nointerlineskip
  \vbox to #1{\hsize\linewidth\ifansmode\color{ansred}\sffamily\small\noindent #2\par\fi\vfil}\par}
% inline answer of zero size (both versions)
\newcommand\ans[1]{\rlap{\smash{\ifansmode\color{ansred}\sffamily #1\fi}}}
% short blank, smashed in both versions; an answer wider than the blank
% reports Overfull \hbox (fixed-width box with \hfil)
\newcommand\blank[2][28mm]{\smash{\underline{\hbox to #1{\hfil
  \ifansmode{\color{ansred}\sffamily\small #2}\else\vphantom{Xg}\fi\hfil}}}}

% ------------------------------------------------ sheet header
\newcommand\sheethead[3]{% title, subtitle line, right-hand info
  {\sffamily\bfseries\LARGE #1\par}\vspace{2pt}
  % fixed-width line: subtitle and info that do not fit report Overfull \hbox
  {\sffamily\noindent\hbox to\textwidth{#2\hskip 1em plus 1fill #3}\par}\vspace{1pt}
  {\color{rule}\rule{\textwidth}{0.8pt}}\par
  \ansnote{5mm}{Tutor's working, not an official mark scheme}\vspace{1pt}}

% ------------------------------------------------ question layout
% flush-right level tag, e.g. \lvl{A}; spec 9.1 flush-right recipe
\newcommand\lvl[1]{{\unskip\nobreak\hfil\penalty50\hskip1em\hbox{}\nobreak\hfill
  \sffamily\bfseries[#1]\parfillskip=0pt\par}}
\newcounter{qn}
\newcommand\Q{\par\needspace{5\baselineskip}\medskip\stepcounter{qn}%
  \makebox[8mm][l]{\sffamily\bfseries\theqn}}
\newcommand\sub[1]{\par\hangindent=13mm\hangafter=0\makebox[0mm][r]{(#1)\hspace{1.5mm}}}

% ------------------------------------------------ answer lines (spec 6.1)
% Rules sit at the bottom of each pitch; the answer's baselines sit
% 1.2 mm (9 mm pitch) or 6 mm (18 mm pitch) above them. Both versions
% produce a \vbox to n x pitch, so the layout is identical; an answer
% longer than its lines reports Overfull \vbox.
\newlength\lp@pitch \newlength\lp@raise \newcount\lp@n
\def\lp@lines#1#2#3#4{%
  \setlength\lp@pitch{#1}\setlength\lp@raise{#2}%
  \par\nointerlineskip
  \vbox to #3\lp@pitch{\offinterlineskip\hsize\linewidth\lp@n=0
    \loop\ifnum\lp@n<#3 \advance\lp@n by 1
      \vbox to \lp@pitch{\vfil\hbox to\linewidth{\color{black!45}\dotfill}\kern0pt}\repeat}%
  \ifansmode
    \nointerlineskip\vskip-#3\lp@pitch
    \vbox to #3\lp@pitch{\hsize\linewidth\vskip-\lp@raise\hrule height0pt width0pt\prevdepth=0pt
      \color{ansred}\sffamily\small % font first: \small resets \baselineskip
      \baselineskip=\lp@pitch\lineskiplimit=-\maxdimen\parindent=0pt\parskip=0pt
      \leavevmode #4\par\vfil}%
  \fi\par}
\newcommand\alines[2]{\lp@lines{9mm}{1.2mm}{#1}{#2}}
\newcommand\flines[2]{\lp@lines{18mm}{6mm}{#1}{#2}}

% ------------------------------------------------ drawing / graph boxes
% \drawbox{h}{content}: outlined box of fixed height, content centred
\newlength\boxh
\newcommand\drawbox[2]{\par\vspace{2mm}\setlength\boxh{#1}\nointerlineskip
  \vbox{\hbox to\linewidth{\hss\fbox{\vbox to\boxh{\vfil\hbox to\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax{\hss #2\hss}\vfil}}\hss}}\par}
% true-size graph grid: #1 x #2 cm, 2 mm minor, 1 cm major; #3 = answer
% layer drawn only in the answer version, inside the same bounding box
\newcommand\GraphGrid[3]{%
  \begin{tikzpicture}[x=1cm, y=1cm]
    \useasboundingbox (-1.6,-1.2) rectangle (#1+0.4,#2+0.4);
    \foreach \i in {0,0.2,...,#1} \draw[black!18, line width=0.2pt] (\i,0) -- (\i,#2);
    \foreach \j in {0,0.2,...,#2} \draw[black!18, line width=0.2pt] (0,\j) -- (#1,\j);
    \foreach \i in {0,1,...,#1} \draw[black!40, line width=0.4pt] (\i,0) -- (\i,#2);
    \foreach \j in {0,1,...,#2} \draw[black!40, line width=0.4pt] (0,\j) -- (#1,\j);
    \ifansmode\begin{scope}[ansred, line width=0.9pt]#3\end{scope}\fi
  \end{tikzpicture}}

\endinput
