  \draw[lead] (-1.45,1.45) -- (-5.4,1.4) node[letter, anchor=east] {\Lb{B}{umbilical cord}{脐带}};
  \fill (-2.0,-1.6) circle (1.6pt);
  \draw[lead] (-2.0,-1.6) -- (-5.4,-1.6) node[letter, anchor=east] {\Lb{C}{amniotic fluid}{羊水}};
  \draw[lead] ({3.35*cos(-25)},{3.95*sin(-25)}) -- (5.4,-1.7) node[letter, anchor=west] {\Lb{D}{amniotic sac}{羊膜囊}};
  \fill ({4.05*cos(20)},{4.65*sin(20)}) circle (1.6pt);
  \draw[lead] ({4.05*cos(20)},{4.65*sin(20)}) -- (5.4,1.6) node[letter, anchor=west] {\Lb{E}{uterus wall}{子宫壁}};
  \fill (0.6,-5.6) circle (1.6pt);
  \draw[lead] (0.6,-5.6) -- (5.4,-5.4) node[letter, anchor=west] {\Lb{F}{cervix}{子宫颈}};
