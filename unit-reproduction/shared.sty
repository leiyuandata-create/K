% --------------------------------------------- booklet crops + labels
% \CropFig{name}{width}{labels}: the crop, south-west corner at (0,0),
% one unit = the crop width. Labels use anchors from fig/anchors.tex.
\newcommand\ancpt[2]{\csname anc@#1@#2\endcsname}
\newcommand\CropFig[3]{%
  \begin{tikzpicture}[fig, x=#2, y=#2, baseline=(current bounding box.north)]
    \def\cropname{#1}%
    \node[anchor=south west, inner sep=0] at (0,0) {\includegraphics[width=#2]{fig/#1}};
    #3
  \end{tikzpicture}}
% label at the tail of a printed leader arrow, to its right; #3 = anchor
\newcommand\TailLab[3][west]{\edef\tmp{\noexpand\node[letter, anchor=#1] at (\ancpt{\cropname}{#2}) }\tmp{#3};}
% large number disc over a printed one (the printed discs are too small
% to read from a distance, spec 3.4)
\newcommand\Disc[2]{\edef\tmp{\noexpand\node[circle, draw=black, fill=white, line width=0.7pt,
  inner sep=0pt, minimum size=\discsize, font=\noexpand\discfont] at (\ancpt{\cropname}{#1}) }\tmp{#2};}
\newlength\discsize \setlength\discsize{5mm}
\providecommand\discfont{\bfseries}

% ---- male reproductive system, front view (booklet p.10): A-H at the
% tails of the eight printed arrows. Arrows B, C, D are about 35 px apart
% and G, H 12 px, so B sits above its arrow; G is moved 6.5 mm to the right and sits above its arrow, H below.
\newcommand\FigMaleFront[1][60mm]{\CropFig{mfront}{#1}{%
  \TailLab{bladder}{\Lb{A}{bladder}{膀胱}}%
  \TailLab[south west]{seminal}{\Lb{B}{seminal vesicle}{精囊}}%
  \TailLab{prostate}{\Lb{C}{prostate gland}{前列腺}}%
  \TailLab{spermduct}{\Lb{D}{sperm duct}{输精管}}%
  \TailLab{urethra}{\Lb{E}{urethra}{尿道}}%
  \TailLab{epididymis}{\Lb{F}{epididymis}{附睾}}%
  \edef\tmp{\noexpand\draw[lead] (\ancpt{mfront}{testis}) -- ++(6.5mm,0) node[letter, anchor=south west]}\tmp{\Lb{G}{testis}{睾丸}};%
  \TailLab[north west]{scrotum}{\Lb{H}{scrotum}{阴囊}}}}

