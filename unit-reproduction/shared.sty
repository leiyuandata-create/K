% ---- two ways of making twins. Row X: one egg, one sperm, the zygote
% splits. Row Y: two eggs, two sperm. Each row ends with its two embryos.
\newcommand\SpermMark[2]{% head at (#1,#2), tail to the upper left
  \draw[line width=0.7pt] (#1,#2) .. controls (#1-0.25,#2+0.35) and (#1-0.55,#2+0.15) .. (#1-0.8,#2+0.5);
  \fill (#1,#2) circle (0.11);}
\newcommand\FigTwins[1][5mm]{%
\begin{tikzpicture}[fig, x=#1, y=#1, baseline=(current bounding box.north)]
  % row X (y = 0)
  \node[letter] at (-2.2,0) {X};
  \draw[fill=tissue] (0,0) circle (0.75); \SpermMark{-0.75}{0.3}
  \draw[->, line width=1.2pt] (1.3,0) -- (2.9,0);
  \draw[fill=tissue] (4.0,0) circle (0.75); \draw (4.0,-0.75) -- (4.0,0.75);
