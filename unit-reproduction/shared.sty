  \node[jstep] (c) at (67mm,0) {embryo};
  \node[jstep] (d) at (100.5mm,0) {\zhen{foetus}{foetus}};
  \node[jstep] (e) at (134mm,0) {\zhen{baby}{baby}};
  \foreach \u/\v in {a/b,b/c,c/d,d/e} \draw[->, line width=1.2pt] (\u) -- (\v);
