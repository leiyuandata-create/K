% ---- female reproductive system, front view (own drawing).
% Units: 1 = \fu. Uterus: outer wall, cavity, lining; cervix; vagina;
% oviducts and ovaries mirrored about x = 0.
% Points used by the leaders (computed from the curves):
%   oviduct mid-point: Bezier (2.2,5.45)(3.2,6.3)(4.6,6.5)(5.2,5.6) at t = 0.5 -> (3.85,6.18)
%   lining: Bezier (1.45,5.25)(0.9,4.2)(0.22,3.2)(0.2,2.2) at t = 0.4 -> (0.78,4.01)
%   uterus wall: (-1.8,4.6) lies between the cavity (|x| = 1.1) and the outside (|x| = 2.45)
%   cervix wall: x from 0.2 to 0.85 at y = 1.8 -> (0.52,1.8)
\newcommand\FemaleFrontBody{%
  % outer wall of uterus, cervix and vagina
  \path[fill=tissue] (0,6.1) .. controls (1.3,6.1) and (2.5,5.9) .. (2.5,5.0)
    .. controls (2.5,3.8) and (0.9,3.3) .. (0.85,2.1) -- (0.85,1.5)
    .. controls (0.85,1.2) and (1.05,1.2) .. (1.05,0.9) -- (1.05,-1.2) -- (-1.05,-1.2) -- (-1.05,0.9)
    .. controls (-1.05,1.2) and (-0.85,1.2) .. (-0.85,1.5) -- (-0.85,2.1)
    .. controls (-0.9,3.3) and (-2.5,3.8) .. (-2.5,5.0) .. controls (-2.5,5.9) and (-1.3,6.1) .. (0,6.1) -- cycle;
  \draw (1.05,-1.2) -- (1.05,0.9) .. controls (1.05,1.2) and (0.85,1.2) .. (0.85,1.5) -- (0.85,2.1)
    .. controls (0.9,3.3) and (2.5,3.8) .. (2.5,5.0) .. controls (2.5,5.9) and (1.3,6.1) .. (0,6.1)
    .. controls (-1.3,6.1) and (-2.5,5.9) .. (-2.5,5.0) .. controls (-2.5,3.8) and (-0.9,3.3) .. (-0.85,2.1)
    -- (-0.85,1.5) .. controls (-0.85,1.2) and (-1.05,1.2) .. (-1.05,0.9) -- (-1.05,-1.2);
  % cavity
  \path[fill=white] (-1.45,5.25) -- (1.45,5.25) .. controls (0.9,4.2) and (0.22,3.2) .. (0.2,2.2) -- (0.2,1.45)
    .. controls (0.2,1.2) and (0.5,1.15) .. (0.5,0.9) -- (0.5,-1.2) -- (-0.5,-1.2) -- (-0.5,0.9)
    .. controls (-0.5,1.15) and (-0.2,1.2) .. (-0.2,1.45) -- (-0.2,2.2)
    .. controls (-0.22,3.2) and (-0.9,4.2) .. (-1.45,5.25) -- cycle;
  \draw[line width=0.6pt] (0.5,-1.2) -- (0.5,0.9) .. controls (0.5,1.15) and (0.2,1.2) .. (0.2,1.45) -- (0.2,2.2);
  \draw[line width=0.6pt] (-0.5,-1.2) -- (-0.5,0.9) .. controls (-0.5,1.15) and (-0.2,1.2) .. (-0.2,1.45) -- (-0.2,2.2);
  % lining of the uterus (endometrium): a thick grey band on the cavity edge
  \draw[line width=2.6pt, black!48, line join=round] (0.2,2.2) .. controls (0.22,3.2) and (0.9,4.2) .. (1.45,5.25)
    -- (-1.45,5.25) .. controls (-0.9,4.2) and (-0.22,3.2) .. (-0.2,2.2);
  \foreach \s in {1,-1} {
    \begin{scope}[xscale=\s]
      % ovary and its ligament
      \draw[line width=0.6pt] (3.6,4.3) -- (2.38,4.6);
      \draw[fill=tissueD, rotate around={15:(4.3,4.25)}] (4.3,4.25) ellipse (0.75 and 0.48);
      % oviduct, opening into the top corner of the cavity
      \draw[tube] (1.5,5.3) -- (2.2,5.45) .. controls (3.2,6.3) and (4.6,6.5) .. (5.2,5.6)
        .. controls (5.45,5.2) and (5.4,4.9) .. (5.25,4.65);
      % funnel (fimbriae) at the end of the oviduct
      \foreach \a/\b in {4.85/4.05, 5.2/3.95, 5.55/4.1}
        \draw[line width=0.7pt, line cap=round] (5.25,4.65) .. controls (5.25,4.4) and (\a,4.3) .. (\a,\b);
    \end{scope}}}
