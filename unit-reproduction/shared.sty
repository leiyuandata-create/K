% ---- the menstrual cycle on one line: thickness of the uterus lining
% against the day of the cycle, and the four stages (booklet p.14-15).
% x: 1 unit = 1 day; y: 1 unit = \fu.
\newcommand\FigCycleBar[1][4.6mm]{%
\begin{tikzpicture}[fig, x=#1, y=6mm, baseline=(current bounding box.north)]
  \path[fill=black!22] (0,0) -- (0,1.7) -- (1,1.5) -- (3,0.9) -- (5,0.45) -- (7,0.6) -- (10,1.1)
    -- (14,1.6) -- (18,1.85) -- (24,1.9) -- (27,1.85) -- (28,1.7) -- (28,0) -- cycle;
  \draw[line width=1pt] (0,1.7) -- (1,1.5) -- (3,0.9) -- (5,0.45) -- (7,0.6) -- (10,1.1)
    -- (14,1.6) -- (18,1.85) -- (24,1.9) -- (27,1.85) -- (28,1.7);
  \draw (0,0) -- (28,0);
  \foreach \d in {1,5,10,14,20,25,28} {\draw (\d,0) -- (\d,-0.25); \node[anchor=north] at (\d,-0.3) {\d};}
  \node[anchor=north] at (14,-1.05) {\zhen{周期的第几天}{day of the cycle}};
  \node[anchor=east, align=right] at (-0.6,0.95) {\zhen{子宫\\内膜}{uterus\\lining}};
  % stage brackets: 1 = days 0-5, 2 = 5-13, 3 = 13-15, 4 = 15-28
  \foreach \a/\b/\k in {0/5/1, 5/13/2, 13/15/3, 15/28/4} {
    \draw[line width=0.9pt] (\a+0.15,2.75) -- (\a+0.15,3.05) -- (\b-0.15,3.05) -- (\b-0.15,2.75);
    \node[letter, anchor=south] at ({(\a+\b)/2},3.1) {\k};}
  % the egg leaves the ovary on about day 14
  \draw[fill=white, line width=0.9pt] (14,2.35) circle (0.42 and 0.3);
\end{tikzpicture}}

% ---- hormone levels through the cycle (shapes after booklet p.14).
% #2 = ov: oestrogen and progesterone (from the ovaries);
% #2 = pit: LH and FSH (from the pituitary gland).
% Curves are sums of Gaussians; d is the day.
\newcommand\FigHormones[2][4.2mm]{%
\begin{tikzpicture}[fig, x=#1, y=5mm, baseline=(current bounding box.north),
    declare function={g(\d,\m,\s)=exp(-((\d-\m)/\s)^2);}]
  \draw[->] (0,0) -- (29.5,0); \draw[->] (0,0) -- (0,6.3);
  \foreach \d in {1,5,10,14,20,25,28} {\draw (\d,0) -- (\d,-0.25); \node[anchor=north] at (\d,-0.3) {\d};}
  \node[anchor=north] at (14,-1.35) {\zhen{周期的第几天}{day of the cycle}};
  \node[rotate=90, anchor=south] at (-0.5,3) {\zhen{激素水平}{hormone level}};
  \draw[dashed, line width=0.6pt] (14,0) -- (14,6.2);
  \def\tmp{#2}\def\ov{ov}%
  \ifx\tmp\ov
    \draw[line width=1.3pt] plot[domain=0:28, samples=85, smooth] (\x,{5*(0.14+0.86*g(\x,12.6,2.5)+0.46*g(\x,21.5,3.6))});
    \draw[line width=1.3pt, dashed] plot[domain=0:28, samples=85, smooth] (\x,{5*(0.05+0.92*g(\x,21.5,4.1))});
    \node[anchor=south west] at (0.8,5.15) {\zhen{oestrogen 雌激素}{oestrogen}};
    \node[anchor=south] at (22.0,4.95) {\zhen{progesterone 孕激素}{progesterone}};
  \else
    \draw[line width=1.3pt] plot[domain=0:28, samples=140, smooth] (\x,{5*(0.12+1.02*g(\x,14,1.05))});
    \draw[line width=1.3pt, dashed] plot[domain=0:28, samples=140, smooth] (\x,{5*(0.24+0.34*g(\x,14,1.2)+0.16*g(\x,3,3))});
    \node[anchor=west] at (15.6,5.0) {LH};
    \node[anchor=south west] at (16.2,1.45) {FSH};
  \fi
\end{tikzpicture}}

