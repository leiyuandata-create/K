% the wall between 110 and 165 degrees. Leader points:
%   placenta (band middle, 137 deg, r between 3.1 and 3.9)
%   uterus wall at 20 deg, between the two ellipses
%   amniotic sac: the thin line 0.3 inside the inner ellipse, at -25 deg
\newcommand\FigWomb[1][5mm]{%
\begin{tikzpicture}[fig, x=#1, y=#1, baseline=(current bounding box.north)]
  % wall and cervix
  \path[fill=tissue] (0,0) ellipse (4.4 and 5.0);
  \path[fill=tissue] (-1.0,-4.6) rectangle (1.0,-6.3);
  \draw (-1.0,-6.3) -- (-1.0,-4.87); \draw (1.0,-6.3) -- (1.0,-4.87);
  \draw (-1.0,-4.87) arc (-103.1:-436.9:4.4 and 5.0);
  \path[fill=fluid] (0,0) ellipse (3.7 and 4.3);
  \draw[line width=0.6pt] (0,0) ellipse (3.7 and 4.3);
  % cervical canal, closed by a plug
  \path[fill=white] (-0.18,-6.3) rectangle (0.18,-4.9);
  \draw[line width=0.6pt] (-0.18,-6.3) -- (-0.18,-4.9) (0.18,-6.3) -- (0.18,-4.9);
  \fill[black!45] (-0.18,-4.9) rectangle (0.18,-4.35);
  % placenta
  \path[fill=black!42] plot[domain=110:165, samples=24] ({3.7*cos(\x)},{4.3*sin(\x)})
    -- plot[domain=165:110, samples=24] ({2.95*cos(\x)},{3.5*sin(\x)}) -- cycle;
  \draw[line width=0.6pt] plot[domain=110:165, samples=24] ({2.95*cos(\x)},{3.5*sin(\x)});
  % amniotic sac
  \draw[line width=0.6pt, dashed] (0,0) ellipse (3.35 and 3.95);
  % foetus: curled body, head down, arm and leg
  \draw[fill=white, line width=0.9pt, rotate around={-20:(0.35,0.75)}] (0.35,0.75) ellipse (1.15 and 1.6);
  \draw[fill=white, line width=0.9pt] (0.15,-1.55) circle (1.05);
  \draw[fill=white, line width=0.9pt] (1.05,1.75) .. controls (2.0,1.5) and (2.1,0.4) .. (1.45,0.05)
