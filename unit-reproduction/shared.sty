% ---------------------------------------------------- lost-mark list
% Numbered once here (spec 7.2). Source: the booklet plus teaching
% observation -- no examiner report.
\newcommand\defL[3]{%
  \expandafter\def\csname L@n@#1\endcsname{#2}%
  \expandafter\def\csname L@t@#1\endcsname{#3}}
\newcommand\Lref[1]{L\csname L@n@#1\endcsname}
\newcommand\Ltext[1]{\csname L@t@#1\endcsname}

\defL{chromo}{1}{Gametes have 23 chromosomes (one set); body cells and the zygote have 46 (23 pairs).}
\defL{fert}{2}{Fertilisation is the sperm nucleus fusing with the egg nucleus. It happens in the oviduct, not in the uterus or the ovary.}
\defL{adapt}{3}{An adaptation answer names the feature AND says how it helps.}
\defL{parts}{4}{Name the exact part: ovary makes eggs, uterus holds the foetus, cervix is the ring of muscle at the base of the uterus; testes make sperm, the epididymis stores them, the urethra carries semen out.}
\defL{ovul}{5}{Ovulation is the release of an egg from an ovary (about day 14). Menstruation is the loss of the uterus lining (from day 1).}
\defL{horm}{6}{Each hormone has one job and one source: FSH and LH come from the pituitary gland, oestrogen and progesterone from the ovaries.}
\defL{sex}{7}{The sperm decides the sex of the baby: every egg carries X, a sperm carries X or Y. The chance of a boy is 50\,\% every time.}
\defL{stages}{8}{Zygote, then embryo, then foetus. Implantation is the embryo sinking into the uterus lining; it is not fertilisation.}
\defL{nomix}{9}{The mother's blood and the foetus's blood never mix. Substances cross the placenta by diffusion: name the substance and the direction.}
\defL{diff}{10}{Diffusion is from a high concentration to a low concentration; the villi give a large surface area.}
\defL{twins}{11}{Identical twins: one egg, one sperm, the zygote splits. Non-identical twins: two eggs, two sperm.}
\defL{graph}{12}{Describe = the trend with numbers and units read from the graph. Suggest or explain = a reason. Do not give a reason when asked to describe.}
\defL{fluid}{13}{Amniotic fluid cushions and protects the foetus; food and oxygen come through the placenta and the umbilical cord.}
\defL{ivf}{14}{In IVF the egg is fertilised outside the body, in a dish; the embryo is then put into the uterus to grow.}

