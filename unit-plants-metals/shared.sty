% ---- metal layers: pure (straight rows) and alloy (rows bent by big atoms)
\newcommand\FigPure[1][4mm]{%
\begin{tikzpicture}[fig, x=#1, y=#1, baseline=(current bounding box.north)]
  \foreach \x/\y in \geomPure {\draw[fill=atom, line width=0.5pt] (\x,\y) circle (\geomRs);}
\end{tikzpicture}}
% pure metal after a force: top two rows slid one atom to the right
\newcommand\FigPureSlid[1][4mm]{%
\begin{tikzpicture}[fig, x=#1, y=#1, baseline=(current bounding box.north)]
  \foreach \x/\y in \geomPure {
    \pgfmathsetmacro\sx{\y > 1.5 ? 1 : 0}
    \draw[fill=atom, line width=0.5pt] (\x+\sx,\y) circle (\geomRs);}
  \draw[->, line width=1.2pt] (1,4.0) -- (5,4.0);
\end{tikzpicture}}
\newcommand\FigAlloy[1][4mm]{%
\begin{tikzpicture}[fig, x=#1, y=#1, baseline=(current bounding box.north)]
  \foreach \x/\y in \geomAlloySmall {\draw[fill=atom, line width=0.5pt] (\x,\y) circle (\geomRs);}
  \foreach \x/\y in \geomAlloyBig {\draw[fill=bigatom, line width=0.5pt] (\x,\y) circle (\geomRb);}
\end{tikzpicture}}

% ---- rusting tubes: A dry air, B boiled water under oil, C tap water + air
% tube: width 2w (w = 0.8), straight wall from y = w to y = 7, round bottom
\newcommand\TubeOutline[1]{% x shift
  \draw[line width=0.9pt] (#1-0.8,7) -- (#1-0.8,0.8) arc (180:360:0.8) -- (#1+0.8,7);}
\newcommand\Cork[1]{\draw[fill=black!15, line width=0.7pt] (#1-0.92,6.6) rectangle (#1+0.92,7.6);}
% liquid up to height #2 in tube at #1, fill style #3
\newcommand\Liquid[3]{\fill[#3] (#1-0.8,#2) -- (#1-0.8,0.8) arc (180:360:0.8) -- (#1+0.8,#2) -- cycle;}
% nail from (x1,y1) to (x2,y2): shaft plus a head at the first end
\newcommand\Nail[4]{\draw[line width=2pt, black!65] (#1,#2) -- (#3,#4);
  \draw[line width=3.2pt, black!65] ($(#1,#2)!0.12cm!90:(#3,#4)$) -- ($(#1,#2)!0.12cm!-90:(#3,#4)$);}
\newcommand\FigRustTubes[1][4.4mm]{%
\begin{tikzpicture}[fig, x=#1, y=#1, baseline=(current bounding box.north)]
  % A: granules in the bottom (top of the pile y = 1.24), nail leaning on the
  % wall and resting on the granules, corked
  \foreach \x/\y in \geomGranules {\draw[fill=black!12, line width=0.4pt] (\x,\y) circle (0.17);}
  \Nail{-0.72}{4.8}{0.45}{1.27}
  \TubeOutline{0}\Cork{0}
  \node[letter] at (0,-0.9) {A};
  % B: boiled water to 4.6, oil layer 4.6-5.2, nail fully under water; the
  % nail's foot is on the glass: at x offset 0.3 the inside bottom is at
  % y = 0.8 - sqrt(0.8^2 - 0.3^2) = 0.06
  \Liquid{8}{5.2}{oil}\Liquid{8}{4.6}{water}
  \draw[line width=0.5pt] (7.2,4.6) -- (8.8,4.6);
  \Nail{7.28}{3.9}{8.3}{0.12}
  \TubeOutline{8}\Cork{8}
  \node[letter] at (8,-0.9) {B};
  % C: tap water to 2.8, nail half out of the water, open to the air
  \Liquid{16}{2.8}{water}
  \Nail{15.28}{5.0}{16.3}{0.12}
  \TubeOutline{16}
  \node[letter] at (16,-0.9) {C};
  % labels (right of each tube); leader ends on the item named
  \draw[lead] (-0.55,0.75) -- (-1.5,0.2) node[anchor=east, align=right] {calcium\\chloride};
  \draw[lead] (8.6,4.9) -- (9.5,5.6) node[anchor=west] {oil};
  \draw[lead] (8.6,2.6) -- (9.5,2.4) node[anchor=west, align=left] {boiled\\water};
  \draw[lead] (16.6,1.8) -- (17.5,1.6) node[anchor=west, align=left] {tap\\water};
\end{tikzpicture}}

% ---- reactivity series (Metallic materials p.20), re-drawn with the
% booklet's wording: four groups, then the three "react with" ranges,
% each drawn under the groups it covers, its label on the arrow
\newcommand\FigReactivity{%
\begin{tikzpicture}[fig, baseline=(current bounding box.north),
    grp/.style={draw=black!55, fill=boxfill, rounded corners=1mm, align=left, anchor=north west, inner sep=1.4mm}]
  \node[grp] (g1) at (0,0) {\begin{tabular}{@{}l@{\hspace{3mm}}l@{}}potassium & lithium\\sodium & calcium\end{tabular}};
  \node[grp] (g2) at ([xshift=4mm]g1.north east) {\begin{tabular}{@{}l@{\hspace{3mm}}l@{}}magnesium & iron\\aluminium & tin\\zinc & lead\end{tabular}};
  \node[grp] (g3) at ([xshift=4mm]g2.north east) {copper\\mercury\\silver};
  \node[grp] (g4) at ([xshift=4mm]g3.north east) {gold};
  \coordinate (base) at (g1.south west);
  \foreach \k/\t/\e in {1/react with water/g1, 2/react with acids/g2, 3/react with oxygen/g3}{
    \draw[<->, line width=1pt] ($(base)+(0,-\k*6.6mm+1.6mm)$) -- ($(\e.east |- base)+(0,-\k*6.6mm+1.6mm)$)
      node[pos=0.5, fill=white, inner sep=1pt] {\t};}
  \draw[->, line width=1pt] ([yshift=3mm]g1.north west) -- ([yshift=3mm]g4.north east);
  \node[anchor=south west] at ([yshift=3.3mm]g1.north west) {most reactive};
  \node[anchor=south east] at ([yshift=3.3mm]g4.north east) {least reactive};
\end{tikzpicture}}

% ---- measuring cylinder: scale 0-50 mL, level #2 mL, object if #3 = 1
% inside width 2, scale height 10 units for 50 mL (0.2 unit per mL)
\newcommand\FigCylinder[3][3.2mm]{%
\begin{tikzpicture}[fig, x=#1, y=#1, baseline=(current bounding box.north)]
  \pgfmathsetmacro\lev{0.2*#2}
  \fill[water] (0,0) rectangle (2,\lev);
  \draw[line width=0.6pt] (0,\lev) .. controls (0.5,\lev-0.25) and (1.5,\lev-0.25) .. (2,\lev);
  \draw[line width=0.9pt] (0,11) -- (0,0) -- (2,0) -- (2,11);
  \draw[line width=0.9pt] (-0.6,0) -- (2.6,0);
  \foreach \v in {0,5,...,50} {\pgfmathsetmacro\yy{0.2*\v}
    \draw[line width=0.4pt] (2,\yy) -- (1.55,\yy);}
  \foreach \v in {10,20,...,50} {\pgfmathsetmacro\yy{0.2*\v}
    \draw[line width=0.7pt] (2,\yy) -- (1.2,\yy); \node[anchor=west] at (2.15,\yy) {\v};}
  \ifnum#3=1 \draw[fill=black!35, line width=0.6pt] (0.55,0.15) rectangle (1.25,1.6); \fi
\end{tikzpicture}}

% ---- melting point of mixtures of metals X and Y (made-up data)
% x: % of X, 0-100 -> 0-10 units; y: 150-350 C -> 0-8 units
\def\mpdata{0/330,20/290,40/248,60/206,70/190,80/214,100/262}
\newcommand\FigMPGraph[1][5.2mm]{%
\begin{tikzpicture}[fig, x=#1, y=#1, baseline=(current bounding box.north)]
  \foreach \i in {0,1,...,10} \draw[black!20, line width=0.3pt] (\i,0) -- (\i,8);
  \foreach \j in {0,1,...,8} \draw[black!20, line width=0.3pt] (0,\j) -- (10,\j);
  \draw[->] (0,0) -- (10.6,0); \draw[->] (0,0) -- (0,8.6);
  \foreach \v in {0,20,...,100} \node[below] at (\v/10,0) {\v};
  \foreach \t in {150,200,...,350} \node[left] at (0,{(\t-150)/25}) {\t};
  \node[below=5mm] at (5,0) {percentage of metal X (\%)};
  \node[rotate=90, above=14mm] at (0,4) {melting point (\textdegree C)};
  \draw[line width=1pt] plot[mark=x, mark size=3pt, mark options={line width=1pt}]
    coordinates {(0,7.2) (2,5.6) (4,3.92) (6,2.24) (7,1.6) (8,2.56) (10,4.48)};
\end{tikzpicture}}

