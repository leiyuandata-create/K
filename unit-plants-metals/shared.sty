% --------------------------------------------- booklet crops + labels
% \CropFig{name}{width}{labels}: the crop, south-west corner at (0,0),
% one unit = the crop width. Labels use anchors from fig/anchors.tex.
\newcommand\ancpt[2]{\csname anc@#1@#2\endcsname}
\newcommand\CropFig[3]{%
  \begin{tikzpicture}[fig, x=#2, y=#2, baseline=(current bounding box.north)]
    \def\cropname{#1}%
    \node[anchor=south west, inner sep=0] at (0,0) {\includegraphics[width=#2]{fig/#1}};
    #3
  \end{tikzpicture}}
% letter at the tail of a printed leader arrow: left (L) or right (R) of it
\newcommand\TailL[2]{\edef\tmp{\noexpand\node[letter, anchor=east] at (\ancpt{\cropname}{#1}) {#2};}\tmp}
\newcommand\TailR[2]{\edef\tmp{\noexpand\node[letter, anchor=west] at (\ancpt{\cropname}{#1}) {#2};}\tmp}
% own leader line from a part (anchor) to a label point (x,y), label side
\newcommand\LeadTo[4]{\edef\tmp{\noexpand\fill (\ancpt{\cropname}{#1}) circle (0.006);
  \noexpand\draw[lead] (\ancpt{\cropname}{#1}) -- #2 node[letter, anchor=#3] {#4};}\tmp}

% ---- flower section (Green Machines p.6): A-F at the printed arrows
\newcommand\FigFlower[1][46mm]{\CropFig{flower}{#1}{%
  \TailL{stigma}{A}\TailL{style}{B}\TailL{ovary}{C}%
  \TailR{anther}{D}\TailR{filament}{E}\TailR{sepal}{F}}}

% ---- opened bean seed (Green Machines p.12)
\newcommand\FigSeed[1][60mm]{\CropFig{seed}{#1}{%
