% ---------------------------------------------------- lost-mark list
% Numbered once here (spec 7.2); the slides show the most common ones and
% the exporter reads these definitions for \Lref in the notes. Source:
% the two booklets plus teaching observation -- no examiner report.
\newcommand\defL[3]{%
  \expandafter\def\csname L@n@#1\endcsname{#2}%
  \expandafter\def\csname L@t@#1\endcsname{#3}}
\newcommand\Lref[1]{L\csname L@n@#1\endcsname}
\newcommand\Ltext[1]{\csname L@t@#1\endcsname}

\defL{pollfert}{1}{Pollination is the transfer of pollen from anther to stigma; fertilisation is when the pollen nucleus fuses with the ovule nucleus.}
\defL{asexual}{2}{Asexual reproduction has one parent, no gametes and identical offspring (clones).}
\defL{adapt}{3}{An adaptation answer names the feature AND says how it helps.}
\defL{photoeq}{4}{Photosynthesis: carbon dioxide + water to glucose + oxygen; light energy and chlorophyll go above the arrow.}
\defL{respire}{5}{Plants respire all the time, day and night; they photosynthesise only in the light.}
\defL{iodine}{6}{Iodine tests for starch, not glucose: blue-black means starch is present.}
\defL{xylem}{7}{Xylem carries water and minerals up from the roots; phloem carries glucose.}
\defL{osmosis}{8}{Osmosis: water moves from a high to a low concentration of water through a semi-permeable membrane.}
\defL{transp}{9}{Water is pulled up because it evaporates from the leaves through the stomata (transpiration), not because the plant sucks.}
\defL{density}{10}{Density = mass divided by volume, with units g/cm$^{3}$ or g/mL.}
\defL{displace}{11}{Volume by displacement = final reading minus first reading.}
\defL{justify}{12}{A choice of metal needs the property linked to the use, and a comparison with another metal.}
\defL{alloy}{13}{Alloys are harder because different-sized atoms disrupt the layers, so the layers cannot slide easily.}
\defL{rust}{14}{Rusting needs both water and oxygen; boiled water and an oil layer remove the oxygen.}
\defL{wordeq}{15}{Word equations: metal oxide, metal hydroxide + hydrogen, metal chloride + hydrogen.}
\defL{react}{16}{A reactivity claim needs evidence, and metals low in the series (copper, silver, gold) do not react with dilute acid.}

