% ---------------------------------------------------- lost-mark list
% Numbered once here; the handout prints all of them, the slides the
% most common ones (spec 7.2). Source: the notes booklet plus teaching
% observation -- no examiner report is cited.
\newcommand\LMtitle[1]{\ifcase#1\or
  Angles measured from the mirror\or
  ``The image is on the mirror''\or
  Mixing light like paint\or
  ``The filter adds colour''\or
  Refraction direction reversed\or
  ``Light bends because it hits the glass''\or
  Missing arrows and dotted lines\or
  Pupil and iris swapped\fi}
\newcommand\LMtext[1]{\ifcase#1\or
  The \tAoI{} and \tAoR{} are measured from the \textbf{\tNormal}, not from the mirror surface. A ray at 30\textdegree{} to the mirror has $i = 60^\circ$.\or
  A plane-mirror image is \textbf{behind} the mirror, the \textbf{same distance} behind as the object is in front. A person 2~m from a mirror is 4~m from their image.\or
  Red + green \emph{light} = \textbf{yellow}, not brown. Primary colours of light are \textbf{red, green, blue}; red, yellow, blue are paint (pigment) primaries.\or
  A filter only \textbf{transmits} its own colour and \textbf{absorbs} the rest. It never turns white light red by ``adding red''.\or
  Into a slower (more optically dense) medium the ray bends \textbf{towards} the normal; out into a faster one it bends \textbf{away}. Along the normal: no bending.\or
  Refraction happens because light \textbf{changes speed} at the boundary. An answer without ``speed'' does not reach Merit.\or
  Rays need \textbf{arrows}; virtual rays (behind a mirror, back-extensions) are \textbf{dotted}. Drawn freehand or without a ruler loses the mark.\or
  The \textbf{iris} (coloured muscle) changes the size of the \textbf{pupil} (the hole). ``The pupil gets bigger by itself'' is not enough.\fi}

% ------------------------------------------------------------ figures
\providecommand\figfont{\small}
\newlength\fu \setlength\fu{5mm}
\newif\ifFigAns \FigAnsfalse          % answer layer (red) on/off

\tikzset{
  fig/.style={line width=0.8pt, >={Stealth[length=2.4mm,width=1.8mm]},
    every node/.style={font=\figfont, inner sep=1.5pt}},
  ray/.style={line width=1pt, postaction={decorate},
    decoration={markings, mark=at position #1 with {\arrow{Stealth[length=2.6mm,width=2mm]}}}},
  ray/.default=0.55,
  vray/.style={line width=0.9pt, dash pattern=on 3pt off 2pt},
  nrm/.style={line width=0.7pt, dash pattern=on 5pt off 3pt},
  ans/.style={draw=ansred, text=ansred},
  lead/.style={line width=0.5pt},
}

% plane mirror from #1 to #2; hatching on the right of the direction
\newcommand\Mirror[2]{%
  \draw[line width=1.6pt] #1 -- #2;
  \path #1 -- #2 [postaction={decorate}, decoration={markings,
    mark=between positions 0.03 and 0.97 step 2.6mm with
      {\draw[line width=0.5pt] (0,0) -- (-1.5mm,-2mm);}}];}

% small eye symbol at #1 looking in direction #2 (degrees)
\newcommand\EyeSym[2]{%
  \begin{scope}[shift={#1}, rotate=#2]
    \draw[line width=0.8pt] (0.35,0) .. controls (0.05,0.32) and (-0.25,0.2) .. (-0.35,0)
      .. controls (-0.25,-0.2) and (0.05,-0.32) .. (0.35,0);
    \fill (0.12,0) circle (0.1);
  \end{scope}}

% small light source (bulb with short rays) at #1, radius #2
\newcommand\Bulb[2]{%
  \draw[line width=0.8pt, fill=yellow!25] #1 circle (#2);
  \foreach \a in {0,45,...,315}
    \draw[line width=0.6pt] ($#1+(\a:#2*1.35)$) -- ($#1+(\a:#2*1.9)$);}

% ---- 1  how we see: source -> object -> eye
\newcommand\FigHowWeSee[1][\fu]{%
\begin{tikzpicture}[fig, x=#1, y=#1]
  \Bulb{(0,3)}{0.45}
  \node[above=6pt] at (0,3.5) {light source};
  \draw[line width=0.8pt, fill=black!8] (5,-0.2) rectangle (6.6,0.6);
  \node[below] at (5.8,-0.2) {object};
  \draw[ray] (0.6,2.7) -- (5.3,0.6);
  \draw[ray] (5.6,0.6) -- (1.0,-0.1);
  \EyeSym{(0.55,-0.2)}{180}
  \node[below=4pt] at (0.55,-0.4) {eye};
\end{tikzpicture}}

% ---- 2  transparent / translucent / opaque
\newcommand\FigMaterials[1][\fu]{%
\begin{tikzpicture}[fig, x=#1, y=#1]
  \foreach \ox/\kind in {0/0,5.6/1,11.2/2}{
    \begin{scope}[shift={(\ox,0)}]
      \ifcase\kind
        \draw[fill=glass] (2,0) rectangle (2.45,2.6);
        \foreach \y in {0.5,1.3,2.1} \draw[ray=0.3] (0,\y) -- (4.4,\y);
        \node at (2.2,-0.6) {\tTransparent};
      \or
        \draw[fill=black!4, pattern=dots, pattern color=black!45] (2,0) rectangle (2.45,2.6);
        \foreach \y in {0.5,1.3,2.1} \draw[ray=0.6] (0,\y) -- (2,\y);
        \foreach \y/\a in {0.5/-28,0.7/12,1.3/-8,1.4/30,2.1/-20,2.2/18}
          \draw[ray=0.8] (2.45,\y) -- ++(\a:1.6);
        \node at (2.2,-0.6) {\tTranslucent};
      \or
        \draw[fill=black!30] (2,0) rectangle (2.45,2.6);
        \foreach \y in {0.5,1.3,2.1} \draw[ray=0.6] (0,\y) -- (2,\y);
        \node at (2.2,-0.6) {\tOpaque};
      \fi
    \end{scope}}
\end{tikzpicture}}

% ---- 3  shadows: #2 = 0 point source, 1 large source; answer layer
%          (\ifFigAns) draws only the source/object/screen in black and
%          the rays + shadow in red.
\newcommand\FigShadow[2][\fu]{%
\begin{tikzpicture}[fig, x=#1, y=#1]
  \pgfmathsetmacro\H{\gShObjH}\pgfmathsetmacro\X{\gShObjX}\pgfmathsetmacro\S{\gShScrX}
  \ifnum#2=0
    \fill[umbrafill] (\X+0.1,\H) -- (\S,\gShPtEdge) -- (\S,-\gShPtEdge) -- (\X+0.1,-\H) -- cycle;
    \draw[ray=0.3] (0,0) -- (\S,\gShPtEdge);
    \draw[ray=0.3] (0,0) -- (\S,-\gShPtEdge);
    \Bulb{(0,0)}{0.16}
    \node[above=8pt] at (0,0.3) {small source};
    \draw[line width=3pt] (\S+0.12,-\gShPtEdge) -- (\S+0.12,\gShPtEdge);
    \node[right=6pt, align=left] at (\S+0.2,0) {\tUmbra\\only};
  \else
    \fill[penfill] (\X+0.1,\H) -- (\S,\gShPen) -- (\S,\gShUmbra) -- cycle;
    \fill[penfill] (\X+0.1,-\H) -- (\S,-\gShPen) -- (\S,-\gShUmbra) -- cycle;
    \fill[umbrafill] (\X+0.1,\H) -- (\S,\gShUmbra) -- (\S,-\gShUmbra) -- (\X+0.1,-\H) -- cycle;
    \draw[ray=0.25] (0,\gShSrcA) -- (\S,\gShUmbra);
    \draw[ray=0.25] (0,-\gShSrcA) -- (\S,\gShPen);
    \draw[ray=0.25] (0,-\gShSrcA) -- (\S,-\gShUmbra);
    \draw[ray=0.25] (0,\gShSrcA) -- (\S,-\gShPen);
    \draw[line width=0.8pt, fill=yellow!25, rounded corners=1pt] (-0.15,-\gShSrcA) rectangle (0.15,\gShSrcA);
    \node[above=6pt] at (0,\gShSrcA) {large source};
    \draw[line width=3pt] (\S+0.12,-\gShUmbra) -- (\S+0.12,\gShUmbra);
    \draw[line width=1.2pt] (\S+0.12,\gShUmbra) -- (\S+0.12,\gShPen);
    \draw[line width=1.2pt] (\S+0.12,-\gShUmbra) -- (\S+0.12,-\gShPen);
    \node[right=6pt] at (\S+0.2,0) {\tUmbra};
    \node[right=6pt] at (\S+0.2,1.6) {\tPenumbra};
    \node[right=6pt] at (\S+0.2,-1.6) {\tPenumbra};
  \fi
  \draw[line width=0.8pt, fill=black!30] (\X,-\H) rectangle (\X+0.2,\H);
  \node[below=3pt] at (\X+0.1,-2.7) {object};
  \draw[line width=1.2pt] (\S,-2.7) -- (\S,2.7);
  \node[above=3pt] at (\S,2.7) {screen};
\end{tikzpicture}}

% ---- 4  primary colours of light: letters in the regions, key beside
\newcommand\FigRGB[1][\fu]{%
\begin{tikzpicture}[fig, x=#1, y=#1]
  \def\r{2.0}
  \coordinate (R) at (150:1.3); \coordinate (G) at (30:1.3); \coordinate (B) at (270:1.3);
  \fill[red!38] (R) circle (\r);  \fill[green!40] (G) circle (\r);  \fill[blue!32] (B) circle (\r);
  \begin{scope}\clip (R) circle (\r); \fill[yellow!55] (G) circle (\r); \fill[magenta!30] (B) circle (\r); \end{scope}
  \begin{scope}\clip (G) circle (\r); \fill[cyan!35] (B) circle (\r); \end{scope}
  \begin{scope}\clip (R) circle (\r); \clip (G) circle (\r); \fill[white] (B) circle (\r); \end{scope}
  \foreach \c in {R,G,B} \draw[line width=0.8pt] (\c) circle (\r);
  \node at (150:2.2) {\textbf{R}}; \node at (30:2.2) {\textbf{G}}; \node at (270:2.2) {\textbf{B}};
  \node at (90:1.5) {\textbf{Y}}; \node at (210:1.5) {\textbf{M}}; \node at (330:1.5) {\textbf{C}};
  \node at (0,0) {\textbf{W}};
  \node[right, align=left] at (3.9,0.2) {\textbf{R} red, \textbf{G} green, \textbf{B} blue\\[2pt]
    \textbf{Y} yellow = R + G\\ \textbf{M} magenta = R + B\\ \textbf{C} cyan = G + B\\
    \textbf{W} white = R + G + B};
\end{tikzpicture}}

