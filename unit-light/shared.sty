% shadow task: small lamp, ball, screen
\newcommand\TaskShadow[1][\fu]{%
\begin{tikzpicture}[fig, x=#1, y=#1]
  \Bulb{(0,0)}{0.16}
  \draw[line width=0.8pt, fill=black!25] (\gShObjX,0) circle (\gShObjH);
  \draw[line width=1.2pt] (\gShScrX+1,-3) -- (\gShScrX+1,3);
  \node[below] at (0,-0.4) {lamp};
  \node[below] at (\gShObjX,-\gShObjH) {ball};
  \node[below] at (\gShScrX+1,-3) {screen};
  \ifFigAns
    % tangent lines from the point source to the circle
    \pgfmathsetmacro\ta{asin(\gShObjH/\gShObjX)}
    \pgfmathsetmacro\ye{(\gShScrX+1)*tan(\ta)}
    \fill[umbrafill] ({\gShObjX*cos(\ta)^2},{\gShObjX*cos(\ta)*sin(\ta)}) -- (\gShScrX+1,\ye)
      -- (\gShScrX+1,-\ye) -- ({\gShObjX*cos(\ta)^2},{-\gShObjX*cos(\ta)*sin(\ta)}) -- cycle;
    \draw[ray=0.2, ansred] (0,0) -- (\gShScrX+1,\ye);
    \draw[ray=0.2, ansred] (0,0) -- (\gShScrX+1,-\ye);
    \node[right, ansred] at (\gShScrX+1.1,0) {\tUmbra};
    \draw[line width=0.8pt, fill=black!25] (\gShObjX,0) circle (\gShObjH);
  \fi
\end{tikzpicture}}

