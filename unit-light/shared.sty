% ---- 12  refraction: into glass / out of glass / along the normal
\newcommand\FigRefractRules[1][\fu]{%
\begin{tikzpicture}[fig, x=#1, y=#1]
  \foreach \ox/\mode in {0/0,6.4/1,12.8/2}{
  \begin{scope}[shift={(\ox,0)}]
    \fill[glass] (-2.5,-2.6) rectangle (2.5,0);
    \draw[line width=0.8pt] (-2.5,0) -- (2.5,0);
    \draw[nrm] (0,-2.6) -- (0,2.6);
    \node[right] at (-2.5,0.4) {air};  \node[right] at (-2.5,-0.45) {glass};
    \ifcase\mode
      \draw[ray] (\gRrInx,\gRrIny) -- (0,0);
      \draw[ray] (0,0) -- (\gRrOutx,\gRrOuty);
      \node[below=4pt] at (0,-2.6) {towards normal};
    \or
      \draw[ray] (-\gRrOutx,-\gRrOuty) -- (0,0);
      \draw[ray] (0,0) -- (-\gRrInx,\gRrIny);
      \node[below=4pt] at (0,-2.6) {away from normal};
    \or
      \draw[ray] (0.02,2.4) -- (0.02,0);
      \draw[ray] (0.02,0) -- (0.02,-2.4);
      \node[below=4pt] at (0,-2.6) {no bending};
    \fi
  \end{scope}}
\end{tikzpicture}}

