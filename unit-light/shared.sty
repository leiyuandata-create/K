% ---- 8  law of reflection
\newcommand\FigReflect[1][\fu]{%
\begin{tikzpicture}[fig, x=#1, y=#1]
  \Mirror{(-4,0)}{(4,0)}
  \draw[nrm] (0,0) -- (0,3.6);
  \node[above] at (0,3.6) {\tNormal};
  \draw[ray] (\gRefPx,\gRefPy) -- (0,0);
  \draw[ray] (0,0) -- (\gRefQx,\gRefQy);
  \draw[line width=0.6pt] (0,1.3) arc (90:90+\gRefI:1.3);
  \draw[line width=0.6pt] (0,1.55) arc (90:90-\gRefI:1.55);
  \node at ($(90+\gRefI/2:1.85)$) {$i$};
  \node at ($(90-\gRefI/2:2.1)$) {$r$};
  \node[left] at (\gRefPx,\gRefPy) {\tIncident};
  \node[right] at (\gRefQx,\gRefQy) {\tReflected};
  \node[below=4pt] at (-3,0) {mirror};
\end{tikzpicture}}

% ---- 9  image in a plane mirror
\newcommand\FigPlaneImage[1][\fu]{%
\begin{tikzpicture}[fig, x=#1, y=#1]
  \Mirror{(0,-3.0)}{(0,2.2)}
  \draw[line width=1.4pt, -{Stealth[length=3mm]}] (-\gPmOX,\gPmOB) -- (-\gPmOX,\gPmOT);
  \draw[line width=1.2pt, dash pattern=on 4pt off 2pt, -{Stealth[length=3mm]}] (\gPmOX,\gPmOB) -- (\gPmOX,\gPmOT);
  \node[left] at (-\gPmOX,\gPmOB+0.2) {object};
  \node[right] at (\gPmOX,\gPmOB+0.2) {image};
  \foreach \k in {A,B}{
    \draw[ray] (-\gPmOX,\gPmOT) -- (\csname gPmP\k x\endcsname,\csname gPmP\k y\endcsname);
    \draw[ray] (\csname gPmP\k x\endcsname,\csname gPmP\k y\endcsname) -- (\csname gPmE\k x\endcsname,\csname gPmE\k y\endcsname);
    \draw[vray] (\csname gPmP\k x\endcsname,\csname gPmP\k y\endcsname) -- (\gPmOX,\gPmOT);}
  \draw[<->, line width=0.6pt] (-\gPmOX,-3.3) -- node[below] {$d$} (0,-3.3);
  \draw[<->, line width=0.6pt] (0,-3.3) -- node[below] {$d$} (\gPmOX,-3.3);
\end{tikzpicture}}

