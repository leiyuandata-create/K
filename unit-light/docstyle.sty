% docstyle.sty -- printed A4 sheets (handout, in-class work, homework,
% answer files). Headings are bold text over a thin rule and boxes are
% outlines with a light fill: nothing prints as a solid dark area (spec 3.3).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{docstyle}[2026/09/27 Light unit printed sheets]

\RequirePackage{type1cm}
\RequirePackage{fix-cm}
\RequirePackage[a4paper,top=16mm,bottom=20mm,left=17mm,right=17mm,footskip=9mm]{geometry}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathspec}
\setmainfont[Path=fonts/, Extension=.otf, UprightFont=*-regular,
  BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic]{texgyrepagella}
\setsansfont[Path=fonts/, Extension=.otf, UprightFont=*-regular,
  BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic]{texgyreheros}
\setmathsfont(Digits,Latin)[Path=fonts/, Extension=.otf,
  UprightFont=*-regular, ItalicFont=*-italic]{texgyrepagella}
\setmathrm[Path=fonts/, Extension=.otf, UprightFont=*-regular,
  BoldFont=*-bold, ItalicFont=*-italic]{texgyrepagella}

\RequirePackage{shared}
\RequirePackage{array,tabularx,booktabs,multicol,enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage[skins,breakable]{tcolorbox}
\RequirePackage{xr}
\RequirePackage{needspace}

\setlength\parindent{0pt}
\setlength\parskip{3pt plus 1pt}
\renewcommand\arraystretch{1.25}
\setlist{nosep, leftmargin=*, topsep=2pt, itemsep=1pt}
\renewcommand\figfont{\small}

% ------------------------------------------------ headings: text + rule
\titleformat{\section}{\needspace{5\baselineskip}\sffamily\bfseries\large}{\thesection}{0.6em}{}[\vspace{-2pt}{\color{rule}\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{10pt}{5pt}
\titleformat{\subsection}{\sffamily\bfseries\normalsize}{\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{7pt}{2pt}

% ------------------------------------------------ boxes: outline only
\newtcolorbox{keybox}[1][]{enhanced, colback=boxfill, colframe=black!55,
  boxrule=0.6pt, arc=1.5mm, left=2mm, right=2mm, top=1.2mm, bottom=1.2mm,
  fonttitle=\sffamily\bfseries, coltitle=black, colbacktitle=boxfill,
  titlerule=0.4pt, titlerule style={black!55}, #1}
\newtcolorbox{extbox}[1][]{enhanced, colback=white, colframe=black!55,
  boxrule=0.6pt, borderline={0.4pt}{1.2pt}{black!35, dashed}, arc=1.5mm,
  left=2mm, right=2mm, top=1.2mm, bottom=1.2mm,
  fonttitle=\sffamily\bfseries, coltitle=black, colbacktitle=white,
  titlerule=0.4pt, titlerule style={black!55}, #1}

% ------------------------------------------------ footer: signature
\pagestyle{fancy}
\fancyhf{}
\renewcommand\headrulewidth{0pt}
\newcommand\sheetname{}
\fancyfoot[L]{\footnotesize\sffamily\color{sig}\sheetname}
\fancyfoot[C]{\footnotesize\sffamily\color{sig}\thepage}
\fancyfoot[R]{\footnotesize\sffamily\color{sig}Dr. Ryan Lei \textperiodcentered{} Auckland}
\fancypagestyle{plain}{\fancyhf{}%
  \fancyfoot[L]{\footnotesize\sffamily\color{sig}\sheetname}%
  \fancyfoot[C]{\footnotesize\sffamily\color{sig}\thepage}%
  \fancyfoot[R]{\footnotesize\sffamily\color{sig}Dr. Ryan Lei \textperiodcentered{} Auckland}}

% ------------------------------------------------ sheet header
\newcommand\sheethead[3]{% title, subtitle line, right-hand info
  {\sffamily\bfseries\LARGE #1\par}\vspace{2pt}
  {\sffamily #2\hfill #3\par}\vspace{1pt}
  {\color{rule}\rule{\textwidth}{0.8pt}}\par\vspace{4pt}}

% ------------------------------------------------ question layout
% flush-right level tag, e.g. \lvl{A}; spec 9.1 flush-right recipe
\newcommand\lvl[1]{{\unskip\nobreak\hfil\penalty50\hskip1em\hbox{}\nobreak\hfill
  \sffamily\bfseries[#1]\parfillskip=0pt\par}}
\newcounter{qn}
\newcommand\qprefix{}
\newcommand\setpart[1]{\renewcommand\qprefix{#1}\setcounter{qn}{0}}
\newcommand\Q{\par\needspace{4\baselineskip}\medskip\stepcounter{qn}%
  \makebox[9mm][l]{\sffamily\bfseries\qprefix\theqn}}
\newcommand\sub[1]{\par\hangindent=13mm\hangafter=0\makebox[0mm][r]{(#1)\hspace{1.5mm}}}

% answer lines: each line is a \vbox to its pitch (spec 6.1)
\newlength\linepitch \setlength\linepitch{9mm}
\newcommand\aline{\par\nointerlineskip
  \vbox to \linepitch{\vfil\hbox to \linewidth{\color{black!45}\dotfill}\vskip1.2mm}}
\newcommand\alines[1]{\par\vspace{-2pt}\foreach\i in {1,...,#1}{\aline}\par\vspace{2pt}}
% short blank for fill-in words
\newcommand\blank[1][28mm]{\underline{\hspace{#1}}}
% drawing box: fixed height, figure centred; stored length (spec 3.3)
\newlength\boxh
\newcommand\drawbox[2]{\par\vspace{2.5mm}\setlength\boxh{#1}\nointerlineskip
  \vbox{\hbox to\linewidth{\hss\fbox{\vbox to\boxh{\vfil\hbox to\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax{\hss #2\hss}\vfil}}\hss}}\par}

% answer files
\newcommand\ans[1]{{\color{ansred}#1}}
\newcommand\A[1]{\par\medskip\needspace{3\baselineskip}\makebox[9mm][l]{\sffamily\bfseries #1}}

\endinput
